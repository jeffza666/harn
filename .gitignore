# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment secrets; examples contain placeholders only
.env*
!.env.example

# locally installed development skills
/.agents/skills/
/skills-lock.json

# local agent instructions and workflow configuration
/AGENTS.override.md
/CLAUDE.md
/docs/agents/

# superseded planning reference
/docs/specs/harn-roadmap.md

# local-only receipt samples and exports
/private/

# runtime logs
*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
